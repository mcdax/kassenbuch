# Copy to .env and keep it private: chmod 600 .env
# docker compose reads .env automatically; for the CLI: set -a; . ./.env; set +a

# Password for the web interface (recommended as soon as others can reach it)
WEB_PASSWORD=
# Port on this machine (default 8503)
WEB_PORT=8503

# Telegram: token from @BotFather; chat ID via: docker compose run --rm poller telegram-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy topic URL, e.g. https://ntfy.sh/<secret-topic>
NTFY_URL=

# Message for every new purchase (true/false); failing accounts are always reported
NOTIFY_NEW_RECEIPTS=true
